[Unit]
Description=Trade Signal Bot
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/trendfollowers
ExecStart=/home/ubuntu/trendfollowers/venv/bin/python -u /home/ubuntu/trendfollowers/bot.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
